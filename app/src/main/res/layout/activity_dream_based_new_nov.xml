<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <RadioGroup
        android:id="@+id/radioGroup_genre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_fantasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/nov_1"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:button="@drawable/custom_radio_selector"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radio_romantic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/nov_2"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/radio_sf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/nov_3"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/radio_documentary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/nov_4"
                android:textSize="18sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_thriller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_5"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/radio_comedy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_6"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/radio_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_7"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />
    </RadioGroup>

    <!-- 꿈 소설 텍스트 라벨 -->
    <TextView
        android:id="@+id/tvAnalysisLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/spoqahansansneo_bold"
        android:text="@string/title_1"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- 소설 표시 영역 -->
    <ScrollView
        android:id="@+id/scrollGenerated"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/box_border"
        android:overScrollMode="always"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/tvDreamAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/h_null"
                android:minLines="3"
                android:padding="8dp"
                android:textSize="15sp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <!-- “고치고 싶은 내용을 구체적으로 적으세요” 텍스트 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_que_2"
            android:textSize="16sp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit"
            android:layout_marginTop="5dp"
            android:layout_marginStart="130dp"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:text="@string/btn_tit_3"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:textSize="13sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- 아래 사용자 입력 영역 -->
    <EditText
        android:id="@+id/etDreamInput_1"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:autofillHints="username"
        android:background="@drawable/tv_border_2"
        android:gravity="top"
        android:textStyle="bold"
        android:hint="@string/title_que_h_4"
        android:inputType="textMultiLine"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="홈으로"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:textSize="16sp"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:layout_marginEnd="2dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="새장르"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:textSize="16sp"/>
    </LinearLayout>
</LinearLayout>