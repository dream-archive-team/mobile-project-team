<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">


    <android.widget.Button
        android:id="@+id/btn_nov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginStart="25dp"
        android:background="@drawable/rounded_button_2"
        android:text=" 장르별 소설 보러가기 "
        android:textColor="#4E4340"/>

    <android.widget.Button
        android:id="@+id/buttonGoToDiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_marginStart="250dp"
        android:text="꿈 작성하기"
        android:background="@drawable/rounded_button_2"
        android:textColor="#4E4340"/>

    <android.widget.Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="295dp"
        android:background="@drawable/rounded_button_8"
        android:drawableStart="@drawable/ic_logout"
        android:drawablePadding="-25dp"
        android:text="로그아웃"
        android:textSize="12dp"
        android:textColor="#B71C1C"/>

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="375dp"
        android:layout_marginStart="26dp"
        android:padding="8dp">


        <RadioGroup
            android:id="@+id/radioGroupPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주간"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/radioMonthly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="월별"
                android:layout_marginStart="8dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="〈"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:textColor="@android:color/black" />
        <TextView
            android:id="@+id/tvPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.1~8.7"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="〉"
            android:background="@android:color/transparent"
            android:textColor="@android:color/black" />
    </LinearLayout>


    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_below="@id/calendarView"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="-8dp"/>

</RelativeLayout>