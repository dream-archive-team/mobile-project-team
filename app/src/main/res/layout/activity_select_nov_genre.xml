<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 소설 장르 선택 화면 -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="만들고 싶은 소설의\n장르를 고르시오. (택1)"
        android:textColor="#FFFFFF"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="80dp"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="24dp" />
    <View
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:background="@drawable/rounded_button_3"
        android:layout_marginTop="180dp"
        android:layout_centerHorizontal="true"
        />

    <RadioGroup
        android:id="@+id/radioGroup_genre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="60dp"
        android:layout_marginTop="190dp"
        android:layout_marginEnd="-1dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <RadioButton
            android:id="@+id/radio_fantasy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="판타지"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_romantic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="로맨틱"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_sf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="SF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_documentary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="다큐멘터리"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_thriller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="스릴러"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_comedy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="코미디"
            android:textSize="25sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radio_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqahansansneo_bold"
            android:text="액션"
            android:textSize="25sp"
            android:textStyle="bold" />
    </RadioGroup>

    <android.widget.Button
        android:id="@+id/button_next"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="다음"
        android:textSize="20dp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_4"
        android:layout_marginTop="600dp"
        android:layout_centerHorizontal="true"/>


</RelativeLayout>