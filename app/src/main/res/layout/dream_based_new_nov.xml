<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <RadioGroup
        android:id="@+id/rgEnding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEndingOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/nov_1"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:button="@drawable/custom_radio_selector"
                android:gravity="center"
                />

            <RadioButton
                android:id="@+id/rbEndingHappy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/nov_2"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/rbEndingTwist2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/nov_3"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/rbEndingTwist3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/nov_4"
                android:textSize="18sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEndingTwist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_5"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/rbEndingGrowth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_6"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/rbEndingSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nov_7"
                android:textSize="18sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:button="@drawable/custom_radio_selector"
                android:fontFamily="@font/spoqahansansneo_bold"
                android:gravity="center"/>


        </LinearLayout>
    </RadioGroup>
    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginBottom="10dp"/>

    <!-- 꿈 소설 텍스트 -->
    <TextView
        android:id="@+id/tvAnalysisLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_1"
        android:textSize="16sp"
        android:layout_marginStart="13dp"
        android:fontFamily="@font/spoqahansansneo_bold"
        android:textStyle="bold" />

    <!-- 버튼들 -->

    <ScrollView
        android:layout_width="350dp"
        android:layout_height="220dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/box_border"
        android:overScrollMode="always"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDreamAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:padding="8dp"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 고치고 싶은 내용을 구체적으로 적으세요 텍스트 -->
    <TextView
        android:id="@+id/tvAnalysisLabel_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_que_2"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="13dp"
        android:fontFamily="@font/spoqahansansneo_bold"
        android:textStyle="bold" />

    <!-- 작은 입력 영역 -->

    <!-- 하단 버튼들 -->

    <EditText
        android:id="@+id/etDreamInput_1"
        android:layout_width="355dp"
        android:layout_height="190dp"
        android:layout_margin="12dp"
        android:autofillHints="username"
        android:background="@drawable/tv_border_2"
        android:fontFamily="@font/spoqahansansneo_bold"
        android:gravity="top"
        android:hint="@string/title_que_h_4"
        android:inputType="textMultiLine"
        android:paddingStart="5dp"
        android:paddingEnd="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_home"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="@string/btn_tit_1"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:padding="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="@string/btn_tit_2"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:padding="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:text="@string/btn_tit_3"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_login"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="0dp" />

    </LinearLayout>
</LinearLayout>    